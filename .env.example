# Public site name and canonical URL (workbooks say "StudyAssigned" - confirm before launch, see BUILD_SPEC.md Section 9.1)
NEXT_PUBLIC_SITE_NAME=StudyAssigned
NEXT_PUBLIC_SITE_URL=https://studyassigned.example

# Supabase (one project for staging, a separate one for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Phase 5)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (Phase 1+, transactional and enquiry emails)
RESEND_API_KEY=
TEAM_NOTIFICATION_EMAIL=team@studyassigned.example

# Cloudflare Turnstile (form spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# wa.me link target, digits only with country code, e.g. 919999999999
WHATSAPP_NUMBER=
